VITE_API_BASE_URL=http://localhost:4000/api/v1

# Razorpay Checkout.js publishable key-id. Same value as backend's
# RAZORPAY_KEY_ID (it's public/safe to expose client-side; the key SECRET
# never belongs here). See BLUEPRINT-v1.2.md §31. NOT actually read by
# CheckoutPage/OrderDetailPage as of Phase 5+6: POST /checkout/orders/:id/
# retry-payment's response already carries a razorpayKeyId (InitiatePaymentView,
# payments/dto/payment-views.interface.ts) sourced live from the same env
# var on the backend, and the frontend uses that per-call value instead —
# one source of truth, no risk of this var drifting from what the backend
# is actually configured with. Kept here so it's available if a future
# caller ever needs the key before an /initiate-payment round trip.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
