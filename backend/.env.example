# PrintForge backend — environment variables (architecture frozen v1.2)
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/printforge?schema=public

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@printforge.in

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Monitoring (deferred — see final report) ---
SENTRY_DSN=
